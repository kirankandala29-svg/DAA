#include <stdio.h>
#include <time.h>

// Linear Search Function
int linearSearch(int arr[], int n, int key) {
    for (int i = 0; i < n; i++) {
        if (arr[i] == key)
            return i;
    }
    return -1;
}

// Binary Search Function (Array must be sorted)
int binarySearch(int arr[], int n, int key) {
    int low = 0, high = n - 1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (arr[mid] == key)
            return mid;
        else if (arr[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }

    return -1;
}

int main() {
    int n, key;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter %d sorted elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter element to search: ");
    scanf("%d", &key);

    clock_t start, end;
    double time_taken;

    // Linear Search Timing
    start = clock();
    int linearResult = linearSearch(arr, n, key);
    end = clock();

    time_taken = ((double)(end - start)) / CLOCKS_PER_SEC;

    if (linearResult != -1)
        printf("\nLinear Search: Element found at index %d", linearResult);
    else
        printf("\nLinear Search: Element not found");

    printf("\nLinear Search Time = %.10f seconds\n", time_taken);

    // Binary Search Timing
    start = clock();
    int binaryResult = binarySearch(arr, n, key);
    end = clock();

    time_taken = ((double)(end - start)) / CLOCKS_PER_SEC;

    if (binaryResult != -1)
        printf("\nBinary Search: Element found at index %d", binaryResult);
    else
        printf("\nBinary Search: Element not found");

    printf("\nBinary Search Time = %.10f seconds\n", time_taken);

    return 0;
}

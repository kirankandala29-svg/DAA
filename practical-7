#include <iostream>
#include <vector>
#include <climits>

using namespace std;

int main()
{
    int n, amount;

    // Input number of coin denominations
    cout << "Enter the number of coin denominations: ";
    cin >> n;

    vector<int> coins(n);

    // Input coin values
    cout << "Enter the coin denominations: ";
    for (int i = 0; i < n; i++)
    {
        cin >> coins[i];
    }

    // Input target amount
    cout << "Enter the target amount: ";
    cin >> amount;

    // DP array to store minimum coins required
    vector<int> dp(amount + 1, INT_MAX);

    // Base case
    dp[0] = 0;

    // Dynamic Programming Logic
    for (int i = 1; i <= amount; i++)
    {
        for (int j = 0; j < n; j++)
        {
            if (coins[j] <= i && dp[i - coins[j]] != INT_MAX)
            {
                dp[i] = min(dp[i], dp[i - coins[j]] + 1);
            }
        }
    }

    // Output result
    if (dp[amount] == INT_MAX)
    {
        cout << "\nAmount cannot be formed using given coins." << endl;
    }
    else
    {
        cout << "\nMinimum number of coins required = "
             << dp[amount] << endl;
    }

    return 0;
}

